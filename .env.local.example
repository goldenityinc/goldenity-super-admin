VITE_FIREBASE_APP_ID=

# Optional origins untuk tombol "Open App" pada halaman subscription.
VITE_ERP_WEB_ORIGIN=
VITE_POS_WEB_ORIGIN=
VITE_CLINIC_WEB_ORIGIN=
VITE_SCHOOL_ERP_WEB_ORIGIN=
