VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web SDK config.
# Wajib agar login Super Admin via Firebase bisa berjalan di lokal.
# Login Super Admin lewat backend (POST /api/auth/admin/login); Firebase tidak dipakai lagi.

# Optional origins untuk tombol "Open App" pada halaman subscription.
VITE_ERP_WEB_ORIGIN=
VITE_POS_WEB_ORIGIN=
VITE_CLINIC_WEB_ORIGIN=
VITE_SCHOOL_ERP_WEB_ORIGIN=
