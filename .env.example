# VITE_API_BASE_URL: Endpoint Backend REST API
#
# ===== PILIH ATAU B: PILIH SALAH SATU =====
#
# (A) MODE MONOLITH (RECOMMENDED - TANPA CORS):
#     Frontend di-build lalu di-copy ke folder public backend.
#     Browser & Backend = DOMAIN YANG SAMA.
#     Set: VITE_API_BASE_URL=/api
#
# (B) MODE 2 DOMAIN TERSEPISAH (Frontend Railway + Backend Railway = 2 service berbeda):
#     Copy URL Public Domain dari service Backend Railway dashboard.
#     Contoh: VITE_API_BASE_URL=https://goldenity-admin-core-backend.up.railway.app/api
#
VITE_API_BASE_URL=http://localhost:5001/api

# (HANYA JIKA MODE B - 2 DOMAIN) - Override origin untuk media gambar uploads.
# Jika VITE_API_BASE_URL sudah absolute (https://backend.up.railway.app/api) → opsional auto detect origin dari URL itu.
# Tapi jika Anda butuh media origin berbeda (CDN / S3 public), set explisit disini:
# VITE_MEDIA_ORIGIN=https://goldenity-admin-core-backend.up.railway.app

# Firebase Web SDK (Production):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (OPSIONAL) URL Production untuk "Open App" buttons di Subscription:
VITE_ERP_WEB_ORIGIN=
VITE_POS_WEB_ORIGIN=
VITE_CLINIC_WEB_ORIGIN=
